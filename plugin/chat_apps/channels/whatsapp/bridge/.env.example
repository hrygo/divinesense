# Baileys Bridge 服务配置
# 复制此文件为 .env 并修改相应值

# HTTP 服务端口 (默认: 3001)
PORT=3001

# DivineSense Webhook URL
# 开发环境: http://localhost:5230/api/v1/chat_apps/webhook
# 生产环境: https://your-domain.com/api/v1/chat_apps/webhook
DIVINESENSE_WEBHOOK_URL=http://localhost:5230/api/v1/chat_apps/webhook

# Baileys 认证文件路径 (相对于 bridge 目录)
BAILEYS_AUTH_FILE=./baileys_auth_info.json

# Node 环境 (默认: production)
NODE_ENV=production

# 日志级别 (可选: debug, info, warn, error)
LOG_LEVEL=info

# 心跳检查间隔 (秒，可选)
HEARTBEAT_INTERVAL=30
